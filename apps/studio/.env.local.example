# Generado automáticamente por `npx convex dev` la primera vez (no lo escribas a mano
# salvo para copiar este ejemplo a .env.local antes del primer `convex dev`).
NEXT_PUBLIC_CONVEX_URL=

# Variables de entorno DEL DEPLOYMENT DE CONVEX (no de Next.js) — se configuran con:
#   npx convex env set AUDIOMIND_URL https://tu-audiomind.up.railway.app
# OJO: SIN el sufijo /api — convex/mastering.ts agrega /api/... a la llamada.
# Si la configuras CON /api, sale /api/api/... y el backend responde 404.
# Se listan acá solo como referencia de qué necesita existir.
# AUDIOMIND_URL=
